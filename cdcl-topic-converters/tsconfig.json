{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "jsx": "react",
    "lib": ["dom", "es2022"],
    "module": "es2022",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  },
  "include": ["src/**/*"]
}
