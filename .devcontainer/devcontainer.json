{
  "name": "foxglove-schema-converters",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/foxglove-schema-converters",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/foxglove-schema-converters,type=bind",
  "mounts": [
    "source=${localEnv:HOME}/ros2_ws/src/cdcl_umd_msgs,target=/ros_ws/src/cdcl_umd_msgs,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "node --version && npm --version"
}
